# Default keeps the complete local preview. Select mock or http for the first API slices.
VITE_SERVICE_MODE=preview
VITE_API_BASE_URL=/api/v1
# Public stable instance ID. Change it when switching to a different database/service.
VITE_API_INSTANCE=local-api
# Development proxy only: these TP_* variables are NEVER exposed to browser assets.
TP_API_TARGET=http://127.0.0.1:8000
TP_API_TOKEN=
