TP_ENVIRONMENT=development
TP_DATABASE_URL=postgresql+psycopg://thesis_pilot:CHANGE_ME@127.0.0.1:5432/thesis_pilot
TP_REDIS_URL=redis://127.0.0.1:6379/0
# Generate a local secret of at least 32 characters. Never commit the real .env.
TP_API_TOKEN=
TP_AUTH_MODE=bearer
# Workspace mode: generate a separate random access key and set the matching same-origin address.
# TP_WORKSPACE_ORIGIN=http://127.0.0.1:8017
# TP_WORKSPACE_ACCESS_KEY=
# TP_WORKSPACE_SESSION_SECONDS=43200
# TP_WORKSPACE_WEB_ROOT=../web/dist-workspace
TP_CORS_ORIGINS=["http://127.0.0.1:18744"]
TP_WORKER_LEASE_SECONDS=60
TP_WORKER_EXECUTION_TIMEOUT_SECONDS=900
