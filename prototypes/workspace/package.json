{
  "name": "thesis-pilot-workspace-prototype",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run typecheck && vp build",
