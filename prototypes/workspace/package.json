    "test:e2e": "vp exec playwright test"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/vue-3": "3.33.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-vue": "6.0.10",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vue-tsc": "3.3.14"
  }
